+
+it("keeps footer pills below the input and scopes them to their host, workspace and agent", () => {
+  const buttons = store();
+  const plugin = installation();
+  const footer = buttons.addComposerPill(plugin, {
+    id: "stats",
+    workspaceId: "workspace",
+    agentId: "agent",
+    placement: "footer",
+    button: button(),
+  });
+  const entry = buttons.getSnapshot()[0];
+  expect(entry.placement).toBe("composer-footer");
+  expect(buttonMatches(entry, "host-a", "workspace", "agent")).toBe(false);
+  expect(buttonMatches(entry, "host-a", "workspace", "agent", "composer-footer")).toBe(true);
+  expect(buttonMatches(entry, "host-b", "workspace", "agent", "composer-footer")).toBe(false);
+  expect(buttonMatches(entry, "host-a", "other", "agent", "composer-footer")).toBe(false);
+  expect(buttonMatches(entry, "host-a", "workspace", "other", "composer-footer")).toBe(false);
+  footer.update({ label: "5 turns 66 steps" });
+  expect(buttons.getSnapshot()[0].button.label).toBe("5 turns 66 steps");
+  expect(buttons.getSnapshot()[0].key).toBe(entry.key);
+  footer.remove();
+  expect(buttons.getSnapshot()).toEqual([]);
+});
